{
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "pulstraffic.com" }],
      "destination": "https://www.pulstraffic.com/:path*",
      "permanent": true
    }
  ],
  "crons": [
    {
      "path": "/api/cron/daily-job",
      "schedule": "0 */6 * * *"
    }
  ],
  "functions": {
    "src/app/api/cron/daily-job/route.ts": {
      "maxDuration": 120
    }
  }
}

